# Generated artifacts (kept locally only; CI rebuilds them)
generated/graph/*.json
generated/exports/*.graphml
!generated/graph/.gitkeep
!generated/exports/.gitkeep

# Source material (copyrighted books). Keep local only, never commit.
sources/**/*.pdf
sources/**/*.epub
sources/**/*.djvu
sources/**/*.mobi
