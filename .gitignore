# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv
.uv/

# OS
.DS_Store

# Editor
.idea/
.vscode/

# Generated artifacts (kept locally only; CI rebuilds them)
generated/graph/*.json
generated/graph/*.db
generated/exports/*.graphml
!generated/graph/.gitkeep
!generated/exports/.gitkeep

# Web visualization artifacts (copied from generated/v0.3/ via pipeline)
visualization/web/public/graph.json
visualization/web/public/node-details.json

# Agent memory / scratchpad
memory/

# Source material (copyrighted books). Keep local only, never commit.
sources/**/*.pdf
sources/**/*.epub
sources/**/*.djvu
sources/**/*.mobi
